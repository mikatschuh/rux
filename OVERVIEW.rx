// This is a Rux overview useful for getting a feeling for the language.
// First of all Rux:
// - is built up from its type system
// - has optional semicolons
// - simplifies Rust
// - is similar to Rust when possible
// example datatypes
u8 u10 u16 usize u64 // unsigned
i32 i19 i40 isize    // signed
bool
type structtype enumtype fntype // comptime types

// declarations
// immutable
let x usize = 10
let y i32 // checked uninitialization
let z = 10 // type inference (defaults to usize)

// mutable
var a i32 = 11
var a i8
var i = 0

// global constants
let THIS_CANT_CHANGE = 1 // no `const`, instead module level `let`

// type aliases
let Usize = usize

// functions
let main = fn() void {} // return statement can be implicit for any type
let add = fn(a i32, b i32) i32 a + b
let add = fn(a i32, b i32) return a + b // return type inference with return instead of the type

// commas are optional
let long_function = fn(
    is_true       bool
    name          String
    age           usize
    time_of_birth TimeStamp
) bool { ... }

// typing is nominal
// types can be created like this:

// struct
struct Vec3 {
    x f32
    y f32
    z f32
}

// enums
enum State {
    Done,
    Processing,
    NotStarted,
}
// commas can be used to insert a void type

// without commas:
enum State {
    Done       void
    Processing void
    NotStarted void
}

// all combined:
enum Result fn(ok type) {
    Ok ok
    Err enum {
        MissingDigits struct {
            byte -> u8
            span Span
        }
        MissingExponent Span
    }
}

// enums and structs can be declared on the fields themselves but can't be constructed independently from them

Result.Ok(10) // defaults to usize // Result::Ok(10)
Result(i32).Err.MissingDigits.{
    byte: -> bytes[0]
    span: current_span()
} // Result::<i32>::Err(SomeOtherEnum::MissingDigits { bytes: &bytes[0], span: current_span() })
Result(i32).Err.MissingExponent(current_span()) // ParsingResult::Err(SomeOtherEnum::MissingExponent(current_span()))

// control flow
// The control flow constructs are built to allow for maximum freedom
// while still enforcing initialization and scoping of variables
// for control flow that is merely branching, `if`s and `match` can be used:
if condition {}
if optional = Some(x) println("{x}")
if condition foo() else foo2()

match condition {
    true foo()
    false foo2()
}
let not_optional = match optional {
    Some(x) x
    None unreachable // control flow modifier, this signals the compiler that this code can't be reached
}

// wanting to jump to something a label or a loop is needed

loop {

    // implicit `continue`
}

let y = @label {
    break 1
    continue; // jumps always refers to the most inner loop/label
    break @label 2 // explicit labels are also allowed
    continue @label;
    // implicit break
}
// jumps can carry values `()` / `;` but those can be discarded in 90% of the cases:
if condition {
    i++
    break
} // no need for `()`

// defers
// defers are important for not forgetting to free resources
// defers are static statements syntactically behaving like declarations:

if condition defer vector.free() // illegal

if condition { defer vector.free() } // legal

// defers get scheduled to run at a certain scope's exits
// that means they run either at the end or when a jump jumps out of the scope
{
    let vector = Vec.new()
    defer vector.free() // from this point on impossible to forget

    return 0
    // vector is getting freed
}
// when a scope has multiple `defer`s attached to it they run in the opposite order in which they are attached:
{
    let a = 3
    defer a *= 5
    defer a++
}
println("{a}") // a is 20 not 16

// when a defer uses variables
// it uses the variables from its declaration, before they are shadowed if they are
// but they use the definition of the variable at the point they are scheduled to be executed at
{
    let a = 10
    defer println("{a}")

    let a = 1
    return 0
} // prints "10"

{
    let a = 10
    defer println("{a}")
    a = 1
    return 0
} // prints "1"
// defers have a scope they are attached to.
// The scope defaults to the scope they are declared in but they can also be explicitely attached using labels:
{
    let numbers = Vec.new()
    defer @err numbers.free()

    if input_not_valid {
        @err return 0
    }

    return numbers // numbers are not being freed
}
// in this example `numbers` is only getting freed when the `@err` label is exited
// in the OK branch the `@err` label is never entered which means its also never exited
